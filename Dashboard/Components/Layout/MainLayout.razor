@inherits LayoutComponentBase

<!-- Hoofdcontainer die de hele pagina omvat -->
<div style="display: flex; flex-direction: column; min-height: 100vh; font-family: Arial, Helvetica, sans-serif; background-color: #ffffff;">
    
    <!-- Authentieke jaren 2000 PHPMyAdmin Navigatiebalk -->
    <header style="display: flex; background-color: #d4d0c8; border-bottom: 2px solid #808080; padding: 5px 10px 0 10px;">
        <nav style="display: flex; align-items: flex-end; width: 100%; font-size: 13px;">
            
            <!-- Tab: Dashboard (Instellingen) -->
            <a href="/" style="display: flex; align-items: center; padding: 4px 12px; margin-right: 3px; background-color: #eaeaea; border: 1px solid #808080; border-bottom: none; color: #000000; text-decoration: none;">
                Global settings
            </a>
            
            <!-- Tab: Bestanden -->
            <a href="/files" style="display: flex; align-items: center; padding: 4px 12px; margin-right: 3px; background-color: #eaeaea; border: 1px solid #808080; border-bottom: none; color: #000000; text-decoration: none;">
                Files
            </a>
            
            <a href="/preprocessing" style="display: flex; align-items: center; padding: 4px 12px; margin-right: 3px; background-color: #eaeaea; border: 1px solid #808080; border-bottom: none; color: #000000; text-decoration: none;">
                Preprocessing
            </a>
            
            <!-- Tab: Filters -->
            <a href="/filters" style="display: flex; align-items: center; padding: 4px 12px; margin-right: 3px; background-color: #eaeaea; border: 1px solid #808080; border-bottom: none; color: #000000; text-decoration: none;">
                Filters
            </a>

            <!-- Tab: Logs (Live verkeer stream) -->
            <a href="/logs" style="display: flex; align-items: center; padding: 4px 12px; margin-right: 3px; background-color: #eaeaea; border: 1px solid #808080; border-bottom: none; color: #000000; text-decoration: none;">
                Logs
            </a>

            <a href="/login" style="display: flex; align-items: center; padding: 4px 12px; margin-left: auto; margin-bottom: 4px; background-color: #ffffff; border: 1px solid #cc0000; color: #cc0000; text-decoration: none; font-size: 11px; font-weight: bold;">
                Uitloggen
            </a>
            
        </nav>
    </header>
    
    <main style="display: flex; flex-direction: column; flex-grow: 1;">
        @Body
    </main>
</div>