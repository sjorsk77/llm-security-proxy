@page "/filters"
@using llm_protector.protection.filter
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject FilterManagementService FilterService

<!-- Main container using flexbox -->
<div style="display: flex; flex-direction: column; padding: 15px; box-sizing: border-box;">

    <!-- Page header with flexbox -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 10px; margin-bottom: 20px; border-bottom: 2px solid #000000;">
        <div>
            <h2 style="margin: 0; padding: 0; font-weight: bold;">System filters</h2>
        </div>
        <div style="font-size: 13px; color: #555555;">
            Total engines: <strong>@FilterService.GetFilters().Count</strong>
        </div>
    </div>
    
    <!-- Data Table Container (Classic PHPMyAdmin overview style) -->
    <div style="display: flex; flex-direction: column; border: 1px solid #808080;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left; background-color: #ffffff;">
            <thead style="background-color: #d4d0c8; border-bottom: 1px solid #000000;">
                <tr>
                    <th style="padding: 6px; border-right: 1px solid #808080; width: 25%;">Filter name</th>
                    <th style="padding: 6px; border-right: 1px solid #808080; width: 55%;">Description</th>
                    <th style="padding: 6px; width: 20%; text-align: center;">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var filter in FilterService.GetFilters())
                {
                    <tr style="border-bottom: 1px solid #cccccc; background-color: #ffffff;">
                        <td style="padding: 8px 6px; border-right: 1px solid #808080; font-weight: bold; vertical-align: middle;">
                            @filter.Name
                        </td>
                        <td style="padding: 8px 6px; border-right: 1px solid #808080; color: #555555; vertical-align: middle;">
                            @filter.Description
                        </td>
                        <td style="padding: 8px 6px; text-align: center; vertical-align: middle; background-color: #fafafa;">
                            <select value="@(filter.IsEnabled ? "ENABLED" : "DISABLED")" 
                                    @onchange="(e) => OnFilterSelectToggle(filter.Type, e.Value?.ToString())"
                                    style="padding: 2px; font-size: 12px; border: 1px solid #808080; font-weight: bold; color: @(filter.IsEnabled ? "#006600" : "#cc0000"); text-align: center; width: 120px;">
                                <option value="ENABLED" style="color: #006600;">Enabled</option>
                                <option value="DISABLED" style="color: #cc0000;">Disabled</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private void OnFilterSelectToggle(FilterType type, string? selectedValue)
    {
        bool isEnabled = selectedValue == "ENABLED";
        
        // Update direct de centrale JSON configuratie
        FilterService.ToggleFilter(type, isEnabled);
        
        // Systeemlogboek in je terminal
        Console.WriteLine($"[SYS_LOG] [{DateTime.Now:HH:mm:ss}] FILTER_{type} STATE_CHANGED -> {(isEnabled ? "ENABLED" : "DISABLED")}");
    }
}